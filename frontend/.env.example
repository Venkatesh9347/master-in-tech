# MasterInTech Frontend Environment
# All VITE_* values are embedded into the client bundle at build time and are PUBLIC.
# Never place backend secrets (Laravel/SMTP/Razorpay/LiveKit/Ollama) here.

# Backend API base URL. For production this MUST be the HTTPS origin of the Laravel API.
#   Dev:      http://127.0.0.1:8000/api  (or http://localhost:8000/api)
#   Prod:     https://api.yourdomain.com/api
VITE_API_URL=http://127.0.0.1:8000/api

# Google OAuth client ID (public identifier; the client secret stays server-side).
VITE_GOOGLE_CLIENT_ID=
