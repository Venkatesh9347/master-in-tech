# MasterInTech Frontend Environment
# All VITE_* values are embedded into the client bundle at build time and are PUBLIC.
# Never place backend secrets (Laravel/SMTP/Razorpay/LiveKit) here.

# Backend API base URL. This value is injected into the bundle at build time.
#   Dev:      http://127.0.0.1:8001/api  (or http://localhost:8001/api)
#             -> copy this file to frontend/.env for local development.
#   Prod:     https://api.yourdomain.com/api
#             -> put the production HTTPS origin in frontend/.env.production.
#
# REQUIRED FOR PRODUCTION BUILDS: `npm run build` in production mode FAILS if
# VITE_API_URL is missing, so the deployed site can never silently call a
# localhost dev server (enforced in frontend/vite.config.ts).
VITE_API_URL=http://127.0.0.1:8001/api

# Google OAuth client ID (public identifier; the client secret stays server-side).
VITE_GOOGLE_CLIENT_ID=
