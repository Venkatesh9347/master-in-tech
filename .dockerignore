# Keep the Docker build context small and never bake local secrets into images.

.git
.github
backend-incomplete

# Backend: dependencies, local env, local databases, uploaded/storage content
backend/vendor
backend/node_modules
backend/.env
backend/.env.backup
backend/.env.production
backend/storage
backend/database/*.sqlite*

# Frontend: dependencies, build output, local env files
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.*.local

# General
node_modules
*.log
.DS_Store
.idea
.vscode
Thumbs.db

# Generated QA / test artifacts (keep the build context small; never bake these in)
.playwright-mcp
frontend/e2e-10x/artifacts
frontend/e2e-10x/test-results
frontend/e2e-10x/playwright-report
playwright-report
test-results
*.webm
*.zip
