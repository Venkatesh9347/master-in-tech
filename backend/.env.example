APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is recommended for PRODUCTION queue + cache (package: phpredis).
# Leave REDIS_CLIENT=null with CACHE_STORE=database / QUEUE_CONNECTION=database
# for lightweight/single-node deployments, or install phpredis and set CACHE_STORE=redis,
# QUEUE_CONNECTION=redis.
REDIS_CLIENT=null
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MasterInTech"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# MasterInTech OTP Security Configuration
OTP_EXPIRY_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# Sanctum API Token Expiration (minutes); finite to bound stolen-token lifetime
SANCTUM_TOKEN_EXPIRATION=720

# CORS Allowed Origins (Comma-separated for multi-domain production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 3 Video Security Configuration
VIDEO_SECURITY_DRIVER=local_hls
VIDEO_TOKEN_TTL=300
VIDEO_STORAGE_DISK=local

# Future Commercial DRM (Mux / AWS / Cloudflare)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# LiveKit Realtime Classroom Configuration
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=7200

# MasterInTech AI Assistant Configuration
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024

# Local AI model inference via Ollama (self-hosted, optional).
# Set AI_PROVIDER=ollama to route AI requests to a local/on-prem LLM.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Razorpay payment gateway (provision when payments are wired up).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# # Webhooks: order/recurring payments created programmatically in production require webhook verification.
# RAZORPAY_WEBHOOK_URL=

# Dev/Seed only (not used at runtime in production)
SEED_DEFAULT_PASSWORD=password
SEED_LIVE_CLASS_PASSCODE=MIT2026

VITE_APP_NAME="${APP_NAME}"
